{
	"name": "todo",
	"version": "1.1.0",
	"description": "Obsidian sidebar TODO plugin with My Day, suggestions, calendar workspace, and statistics.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test src/**/*.test.ts",
		"lint:obsidian": "eslint src manifest.json LICENSE --config eslint.obsidian.config.mjs",
		"lint:obsidian:community": "node scripts/lint-community-audit.cjs",
		"verify:obsidian-community": "npm run lint:obsidian && npm run lint:obsidian:community"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"todo",
		"tasks"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/json": "^0.14.0",
		"@types/node": "^22.10.0",
		"@typescript-eslint/eslint-plugin": "^8.30.0",
		"@typescript-eslint/parser": "^8.30.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.8.7",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	}
}
